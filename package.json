{
  "name": "urbantwin-market-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc -b --noEmit",
    "sim:dev-data": "tsx src/sim/dev/buildDevData.ts",
    "sim:report": "tsx src/sim/dev/report.ts",
    "sim:export-world": "tsx src/sim/dev/exportWorld.ts",
    "prep": "uv run --project prep python prep/build_all.py && npm run rank:bake",
    "rank:bake": "node src/rank/bake.ts",
    "video": "node video/record.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@deck.gl/aggregation-layers": "9.4.0",
    "@deck.gl/core": "9.4.0",
    "@deck.gl/extensions": "9.4.0",
    "@deck.gl/geo-layers": "9.4.0",
    "@deck.gl/layers": "9.4.0",
    "@deck.gl/mapbox": "9.4.0",
    "@deck.gl/react": "9.4.0",
    "maplibre-gl": "6.12.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
